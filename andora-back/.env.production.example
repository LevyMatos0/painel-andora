NODE_ENV=production
# Railway fornece PORT automaticamente; não é necessário copiá-la.
TRUST_PROXY_HOPS=1
FRONTEND_URLS=https://SEU-PAINEL.vercel.app,https://SEU-SITE.vercel.app
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_COM_PELO_MENOS_32_CARACTERES

# Use referências às variáveis do serviço MySQL no Railway.
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_USER=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
DB_NAME=${{MySQL.MYSQLDATABASE}}
# Na rede privada do mesmo projeto Railway, preserve a configuração TLS do serviço.
# Para um banco externo que exige TLS: DB_SSL=true e DB_SSL_CA se necessário.

# Monte um Volume do Railway neste MESMO caminho antes de publicar.
UPLOAD_DIR=/data/uploads

# Opcional. O plano/provedor precisa permitir conexões SMTP de saída.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tcc2026clm@gmail.com
SMTP_PASSWORD=
CONTACT_EMAIL=tcc2026clm@gmail.com
